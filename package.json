{
  "name": "pi-quiver",
  "version": "6.16.1",
  "description": "Personal pack of Pi coding-agent extensions: context-safe fetch, doc_to_md PDF/DOCX/PPTX-to-Markdown conversion, session naming, a themed ASCII startup header, Opus 4.8 fast mode, and a provider-stall watchdog.",
  "author": "Jacek Juraszek",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjuraszek/pi-quiver.git"
  },
  "homepage": "https://github.com/jjuraszek/pi-quiver#readme",
  "bugs": {
    "url": "https://github.com/jjuraszek/pi-quiver/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "fetch",
    "markdown",
    "pdf",
    "docx",
    "pptx",
    "xlsx",
    "xls",
    "cli"
  ],
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "bin": {
    "pi-quiver": "dist/bin/pi-quiver.js"
  },
  "files": [
    "extensions",
    "prompts",
    "lib",
    "dist",
    "scripts/doc_to_md.py",
    "scripts/docx_numbering.py",
    "types/**/*.d.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check:agents-core": "node scripts/check-agents-core.mjs",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "npx -y tsc --noEmit",
    "test:all": "npm run check:agents-core && npm run test && npm run typecheck",
    "build": "esbuild bin/pi-quiver.ts lib/unpdf-worker.ts --bundle --packages=external --format=esm --platform=node --outdir=dist --outbase=.",
    "prepack": "npm run build"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "prompts": [
      "./prompts/rebase-worktree.md",
      "./prompts/elevator.md"
    ],
    "image": "https://raw.githubusercontent.com/jjuraszek/pi-quiver/main/pi-quiver.png"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/jjurasszek"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@sinclair/typebox": {
      "optional": true
    }
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^31.0.0",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "unpdf": "^2.1.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-codemode": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "@sinclair/typebox": "^0.34.52",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
